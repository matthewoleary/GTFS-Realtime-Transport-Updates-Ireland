# Express server config
PORT=3000
HOST=localhost
HOST_URL=http://localhost:3000

# Docker MySQL server container
DOCKER_SQL_USER=tfi-schedule-user
DOCKER_SQL_PASSWORD=
DOCKER_SQL_ROOT_PASSWORD=
DOCKER_SQL_HOST=127.0.0.1
DOCKER_SQL_DATABASE=tfi-schedule

# GTFS Static Data API
GTFS_SCHEDULE_URL=https://www.transportforireland.ie/transitData/Data/GTFS_All.zip
GTFS_AGENCY_KEY=transportforireland

# GTFS-R API
GTFSR_API_KEY=
GTFSR_API_TRIP_UPDATES_URL=https://api.nationaltransport.ie/gtfsr/v2/TripUpdates
GTFSR_API_VEHICLE_POSITIONS_URL=https://api.nationaltransport.ie/gtfsr/v2/Vehicles
GTFSR_API_TRIP_UPDATES_URL_BACKUP=https://api.nationaltransport.ie/gtfsr/v2/gtfsr

# Application wide timezone
TZ=Europe/Dublin