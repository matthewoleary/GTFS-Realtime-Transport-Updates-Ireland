# Express server config
PORT=3000
HOST=localhost
HOST_URL=http://localhost:3000

# Docker MySQL server container
DOCKER_SQL_PORT=3306
DOCKER_SQL_USER=gtfs_db_user
DOCKER_SQL_PASSWORD=my-secret-pw
DOCKER_SQL_ROOT_PASSWORD=my-secret-pw
DOCKER_SQL_HOST=127.0.0.1
DOCKER_SQL_DATABASE=gtfs_schedule_db

# Config for database testing Docker image
TEST_DOCKER_SQL_PORT=3307
TEST_DOCKER_SQL_USER=gtfs_db_testing_user
TEST_DOCKER_SQL_PASSWORD=my-secret-pw
TEST_DOCKER_SQL_ROOT_PASSWORD=my-secret-pw
TEST_DOCKER_SQL_DATABASE=gtfs_schedule_test_db
TEST_DOCKER_SQL_HOST=127.0.0.1

# GTFS Static Data API
GTFS_SCHEDULE_URL=https://www.transportforireland.ie/transitData/Data/GTFS_All.zip
GTFS_AGENCY_KEY=transportforireland

# GTFS-R API
GTFSR_API_KEY=
GTFSR_API_TRIP_UPDATES_URL=https://api.nationaltransport.ie/gtfsr/v2/TripUpdates
GTFSR_API_VEHICLE_POSITIONS_URL=https://api.nationaltransport.ie/gtfsr/v2/Vehicles
# Fallback URL for GTFS Realtime Trip Updates in case the main endpoint is unavailable
GTFSR_API_TRIP_UPDATES_URL_FALLBACK=https://api.nationaltransport.ie/gtfsr/v2/gtfsr
# Fallback URL for GTFS Realtime Vehicle Positions in case the main endpoint is unavailable
GTFSR_API_VEHICLE_POSITIONS_URL_FALLBACK=

# Application wide timezone
TZ=Europe/Dublin