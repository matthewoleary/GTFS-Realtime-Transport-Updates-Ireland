{
  "name": "gtfs-realtime-feed",
  "version": "1.0.0",
  "description": "App which retrieves gtfs realtime data from Transport for Ireland GTFS-R API",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@hapi/hapi": "^21.4.4",
    "axios": "^1.13.5",
    "bluebird": "^3.7.2",
    "cron": "^4.4.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "gtfs-realtime-bindings": "^1.1.1",
    "lodash": "^4.17.21",
    "moment-timezone": "0.6.0",
    "mysql2": "^3.15.3",
    "node-fetch": "^3.3.2",
    "redis": "^5.11.0",
    "shelljs": "^0.10.0",
    "sqlstring": "^2.3.3",
    "strip-bom-stream": "^5.0.0",
    "tmp-promise": "^3.0.3",
    "untildify": "^6.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "eslint": "^10.0.1",
    "pretty-error": "^4.0.0",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "start": "node . prod",
    "test": "vitest",
    "import": "node ./import/gtfs-import",
    "lint": "xo",
    "test:integration:db": "docker-compose up -d gtfs-db-testing && vitest run src/database/queries/test/mysql-queries.test.js && docker-compose down"
  },
  "author": "Matthew O'Leary",
  "license": "MIT",
  "xo": {
    "rules": {
      "camelcase": [
        "error",
        {
          "properties": "never"
        }
      ],
      "object-curly-spacing": [
        "error",
        "always"
      ],
      "no-unused-expressions": [
        "error",
        {
          "allowTernary": true
        }
      ],
      "eslint-comments/disable-enable-pair": [
        "off"
      ],
      "unicorn/import-style": [
        "error",
        {
          "styles": {
            "path": {
              "named": true
            }
          }
        }
      ],
      "unicorn/prevent-abbreviations": [
        "off"
      ]
    }
  }
}
